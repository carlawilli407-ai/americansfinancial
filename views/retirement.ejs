<%- include('partials/head', {title: 'Retirement Planning - American Financial Associates'}) %>
<body>
  <%- include('partials/topbar') %>
  <div class="wrap">
    <div class="page-head">
      <span class="hp-badge"><span style="margin-right:6px;">&#10003;</span> Expert guidance included</span>
      <h1>Retirement planning</h1>
      <p class="sub">Maximize your IRA, 401(k) rollover, and retirement income with expert guidance at every step.</p>
    </div>

    <!-- Hero -->
    <section class="page-hero reveal">
      <div class="ph-in">
        <div class="ph-text">
          <h1>Retire with confidence</h1>
          <p class="sub">Whether you're rolling over a 401(k), opening a new IRA, or planning your income stream, we'll help you build and protect the savings that will fund your future.</p>
          <div class="quick">
            <a class="btn btn-primary" href="/login">Open an IRA</a>
            <a class="btn ghost" href="/login">Rollover calculator</a>
          </div>
        </div>
        <div class="ph-img">
          <img class="ph-hero-img" src="/static/img/icon-retirement.svg" alt="Illustration of retirement planning features">
        </div>
      </div>
    </section>

    <!-- Key metrics -->
    <section class="reveal">
      <div class="summary">
        <div class="col">
          <div class="lbl">IRA minimum</div>
          <div class="big">$0</div>
          <div class="sub">to open</div>
        </div>
        <div class="col">
          <div class="lbl">Rollover fee</div>
          <div class="big">$0</div>
          <div class="sub">for direct custodian</div>
        </div>
        <div class="col">
          <div class="lbl">Advisor access</div>
          <div class="big">100+</div>
          <div class="sub">CEPAs &amp; CFPs</div>
        </div>
      </div>
    </section>

    <!-- Products grid -->
    <section class="reveal" style="padding-top:0">
      <h2>Retirement products</h2>
      <p class="sub" style="margin-bottom:30px">From rollovers to income strategies, we have the accounts and tools for every stage of your retirement journey.</p>
      <div class="hp-highlight-grid">
        <div class="hp-highlight">
          <svg class="hp-hl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 3h8v4H8zM5 13l2 2 4-4"/></svg>
          <h3>Traditional IRA</h3>
          <p>Potential tax-deferred growth and tax-deductible contributions based on your income.</p>
        </div>
        <div class="hp-highlight">
          <svg class="hp-hl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="8" width="20" height="16" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M10 14h4v4h-4z"/><circle cx="12" cy="14" r="2"/></svg>
          <h3>Roth IRA</h3>
          <p>Tax-free growth and tax-free withdrawals in retirement. No RMDs.</p>
        </div>
        <div class="hp-highlight">
          <svg class="hp-hl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><line x1="14" y1="2" x2="20" y2="8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></svg>
          <h3>401(k) Rollover</h3>
          <p>Consolidate old 401(k) accounts into a single IRA with our rollover specialists.</p>
        </div>
        <div class="hp-highlight">
          <svg class="hp-hl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.59 11.41A2 2 0 0 1 4.24 10h8.52a2 2 0 0 1 1.98 1.64l-2.34 8.86a2 2 0 0 1-1.24 1.24l-8.86 2.34a2 2 0 0 1-2.47-.92z"/><path d="M18 8V2h-2v6h2z"/></svg>
          <h3>Income planning</h3>
          <p>Develop a sustainable withdrawal strategy with our retirement income calculator.</p>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="reveal">
      <h2>Your retirement roadmap</h2>
      <p class="sub">Three simple steps to a stronger retirement.</p>
      <div class="hp-how-grid">
        <div class="hp-step">
          <div class="hp-step-num">1</div>
          <div class="hp-step-title">Assess your needs</div>
          <div class="hp-step-desc">Use our retirement calculator to estimate your income needs and project future savings.</div>
        </div>
        <div class="hp-step">
          <div class="hp-step-num">2</div>
          <div class="hp-step-title">Open &amp; transfer</div>
          <div class="hp-step-desc">Open an IRA or roll over your old 401(k) with step-by-step guidance from our team.</div>
        </div>
        <div class="hp-step">
          <div class="hp-step-num">3</div>
          <div class="hp-step-title">Optimize &amp; monitor</div>
          <div class="hp-step-desc">Review your investments annually and adjust your allocation as you near retirement.</div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="hp-cta-band reveal">
      <div class="hp-cta-in">
        <h2>Ready to start your retirement planning?</h2>
        <p>Open an account online in minutes, or speak with a retirement specialist.</p>
        <div class="hp-cta-actions">
          <a class="btn" href="/login">Open an IRA</a>
          <a class="btn ghost" href="/wealth">Talk to an advisor</a>
        </div>
      </div>
    </section>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
