<section id="accounts" class="sec reveal">
        <h2 class="sec-h">Accounts</h2>
        <div class="sec-sub">Balances, performance, and transfers.</div>
        <div class="grid">
          <% accounts.forEach(function(a){ %>
          <div class="acct">
            <div class="type"><%= a.type %></div>
            <div class="num"><%= a.number %></div>
            <div class="val"><%= h.money(a._marketValue) %></div>
            <div class="gl <%= h.cls(a._gainLoss) %>"><%= h.signedMoney(a._gainLoss) %> (<%= h.pct(a._gainLossPct) %>)</div>
          </div>
          <% }); %>
        </div>
        <div class="card">
          <h2>Multiple-account overview</h2>
          <table>
            <thead><tr><th>Account</th><th>Number</th><th class="num">Value</th><th class="num">Day change</th><th class="num">Gain / loss</th></tr></thead>
            <tbody>
              <% accounts.forEach(function(a){ %>
              <tr><td><%= a.type %></td><td class="muted"><%= a.number %></td><td class="num"><%= h.money(a._marketValue) %></td><td class="num <%= h.cls(a._dayChange) %>"><%= h.signedMoney(a._dayChange) %></td><td class="num <%= h.cls(a._gainLoss) %>"><%= h.signedMoney(a._gainLoss) %></td></tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div class="action-card<%= openPanel === 'transfer' ? ' open' : '' %>" id="action-transfer">
          <div class="action-head" data-panel="transfer"><span class="action-title">Transfer between accounts</span><span class="action-toggle">▼</span></div>
          <div class="action-body">
            <% if (openPanel === 'transfer' && transferred) { %><div class="action-banner pos">Transfer completed — cash has been moved between your accounts.</div><% } %>
            <% if (openPanel === 'transfer' && payError) { %><div class="action-banner neg">Transfer not completed — check that the accounts differ and that sufficient funds are available.</div><% } %>
            <form class="alert-form" method="post" action="/transfer">
              <div class="tt-row"><label>From</label><select name="from"><% accounts.forEach(function(a){ %><option value="<%= a.type %>"><%= a.type %> (#<%= a.number %>) &mdash; <%= h.money(a.cash) %> cash</option><% }); %></select></div>
              <div class="tt-row"><label>To</label><select name="to"><% accounts.forEach(function(a){ %><option value="<%= a.type %>"><%= a.type %> (#<%= a.number %>) &mdash; <%= h.money(a.cash) %> cash</option><% }); %></select></div>
              <div class="tt-row"><label>Amount</label><input name="amount" type="number" step="any" min="0" placeholder="$0.00" required></div>
              <div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Schedule transfer</button></div>
            </form>
          </div>
        </div>

        <div class="action-card<%= openPanel === 'deposit' ? ' open' : '' %>" id="action-deposit">
          <div class="action-head" data-panel="deposit"><span class="action-title">Deposit money</span><span class="action-toggle">▼</span></div>
          <div class="action-body">
            <% if (openPanel === 'deposit' && deposited) { %><div class="action-banner">Deposit submitted — pending. Funds will be credited once reviewed.</div><% } %>
            <% if (openPanel === 'deposit' && payError) { %><div class="action-banner neg">Deposit not completed — check the account and amount, then try again.</div><% } %>
            <form class="alert-form" method="post" action="/deposit">
              <div class="tt-row"><label>Deposit to</label><select name="account_id"><% accounts.forEach(function(a){ %><option value="<%= a.id %>" <%= a.id===defaultAccount.id?'selected':'' %>><%= a.type %> (#<%= a.number %>) &mdash; <%= h.money(a.cash) %> cash</option><% }); %></select></div>
              <div class="tt-row"><label>Amount</label><input name="amount" type="number" step="any" min="0" placeholder="$0.00" required></div>
              <div class="tt-row"><label>Method</label><select name="method"><option>ACH (1-3 business days)</option><option>Check deposit</option><option>Wire transfer</option></select></div>
              <div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Deposit</button></div>
            </form>
          </div>
        </div>

        <div class="action-card<%= openPanel === 'paybills' ? ' open' : '' %>" id="action-paybills">
          <div class="action-head" data-panel="paybills"><span class="action-title">Pay bills</span><span class="action-toggle">▼</span></div>
          <div class="action-body">
            <% if (openPanel === 'paybills' && paid) { %><div class="action-banner">Payment submitted — pending. The payment will be processed once reviewed.</div><% } %>
            <% if (openPanel === 'paybills' && payError) { %><div class="action-banner neg">Payment not completed — check that sufficient funds are available and try again.</div><% } %>
            <form class="alert-form" method="post" action="/pay-bills">
              <div class="tt-row"><label>Pay from</label><select name="account_id"><% accounts.forEach(function(a){ %><option value="<%= a.id %>" <%= a.id===defaultAccount.id?'selected':'' %>><%= a.type %> (#<%= a.number %>) &mdash; <%= h.money(a.cash) %> cash</option><% }); %></select></div>
              <div class="tt-row"><label>Payee</label><input name="payee" type="text" placeholder="e.g. Electric Co." autocomplete="off" required></div>
              <div class="tt-row"><label>Amount</label><input name="amount" type="number" step="any" min="0" placeholder="$0.00" required></div>
              <div class="tt-row"><label>Payment date</label><input name="date" type="date"></div>
              <div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Schedule payment</button></div>
            </form>
          </div>
        </div>

        <div class="action-card<%= openPanel === 'movemoney' ? ' open' : '' %>" id="action-movemoney">
          <div class="action-head" data-panel="movemoney"><span class="action-title">Move money</span><span class="action-toggle">▼</span></div>
          <div class="action-body">
            <% if (openPanel === 'movemoney' && moved) { %><div class="action-banner">Transfer submitted — pending. The external transfer will be sent once reviewed.</div><% } %>
            <% if (openPanel === 'movemoney' && payError) { %><div class="action-banner neg">Transfer not completed — check that sufficient funds are available and try again.</div><% } %>
            <form class="alert-form" method="post" action="/move-money">
              <div class="tt-row"><label>Move from</label><select name="account_id"><% accounts.forEach(function(a){ %><option value="<%= a.id %>" <%= a.id===defaultAccount.id?'selected':'' %>><%= a.type %> (#<%= a.number %>) &mdash; <%= h.money(a.cash) %> cash</option><% }); %></select></div>
              <div class="tt-row"><label>Destination bank</label><input name="external_bank" type="text" placeholder="e.g. Chase ••1234" autocomplete="off" required></div>
              <div class="tt-row"><label>Amount</label><input name="amount" type="number" step="any" min="0" placeholder="$0.00" required></div>
              <div class="tt-row"><label>Transfer date</label><input name="date" type="date"></div>
              <div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Send money</button></div>
            </form>
          </div>
        </div>

        <div class="action-card<%= openPanel === 'externaltransfer' ? ' open' : '' %>" id="action-externaltransfer">
          <div class="action-head" data-panel="externaltransfer"><span class="action-title">External transfer</span><span class="action-toggle">▼</span></div>
          <div class="action-body">
            <% if (openPanel === 'externaltransfer' && externaltransferred) { %><div class="action-banner pos">External transfer submitted — pending. Funds will be sent to your external bank once reviewed.</div><% } %>
            <% if (openPanel === 'externaltransfer' && externalError) { %><div class="action-banner neg">External transfer not completed — verify the destination routing, account number, and that sufficient funds are available.</div><% } %>
            <form class="alert-form" method="post" action="/external-transfer">
              <div class="tt-row"><label>Transfer from</label><select name="account_id"><% accounts.forEach(function(a){ %><option value="<%= a.id %>" <%= a.id===defaultAccount.id?'selected':'' %>><%= a.type %> (#<%= a.number %>) &mdash; <%= h.money(a.cash) %> cash</option><% }); %></select></div>
              <div class="tt-row"><label>Bank logo (URL)</label><input name="bank_logo" type="url" placeholder="https://example.com/logo.svg" autocomplete="off"></div>
              <div class="tt-row"><label>Bank name</label><input name="bank_name" type="text" placeholder="e.g. First National Bank" autocomplete="off" required></div>
              <div class="tt-row"><label>Routing number</label><input name="routing" type="text" inputmode="numeric" pattern="\d{9}" placeholder="9 digits" autocomplete="off" required></div>
              <div class="tt-row"><label>Account holder</label><input name="account_holder" type="text" placeholder="Name on external account" autocomplete="off" required></div>
              <div class="tt-row"><label>Destination account number</label><input name="account_number" type="text" inputmode="numeric" placeholder="External account number" autocomplete="off" required></div>
              <div class="tt-row"><label>Amount</label><input name="amount" type="number" step="any" min="0" placeholder="$0.00" required></div>
              <div class="tt-row"><label>Transfer date</label><input name="date" type="date"></div>
              <div class="tt-row"><label>Reference / memo</label><input name="reference" type="text" placeholder="Optional reference" autocomplete="off"></div>
              <div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Schedule external transfer</button></div>
            </form>
          </div>
        </div>

        <div class="action-card<%= openPanel === 'history' ? ' open' : '' %>" id="action-history">
          <div class="action-head" data-panel="history"><span class="action-title">Transaction history</span><span class="action-toggle">▼</span></div>
          <div class="action-body">
            <% if (pendingCount && pendingCount > 0) { %><div class="action-banner" style="margin-bottom:12px">You have <%= pendingCount %> pending transaction(s). Cash balances will update once reviewed.</div><% } %>
            <% if (transactions && transactions.length) { %>
            <div class="table-wrap">
              <table class="hp-tx-table">
                <thead>
                  <tr>
                    <th>Date</th><th>Description</th><th>Account</th><th>Type</th>
                    <th class="num">Amount</th><th class="num">Balance</th>
                  </tr>
                </thead>
                <tbody>
                  <% transactions.forEach(function(t){ %>
                  <tr>
                    <td class="muted"><%= t.tdate %></td>
                    <td><%= t.description %><% if (t.status === 'pending') { %><span class="tx-pending">PENDING</span><% } %></td>
                    <td><%= t.account_type || (t.account_id ? '#' + t.account_id : '') %></td>
                    <td><span class="role user"><%= t.type %></span></td>
                    <td class="num <%= (t.amount||0) >= 0 ? 'pos' : 'neg' %>"><%= t.amount != null ? h.signedMoney(t.amount) : '—' %></td>
                    <td class="num"><%= t.balance_after != null ? h.money(t.balance_after) : '—' %></td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
            <% } else { %>
            <div class="empty">No transactions yet. Your transaction history will appear here once you start trading or moving money.</div>
            <% } %>
          </div>
        </div>
      </section>
      <section id="fixedincome" class="sec reveal">
        <h2 class="sec-h">Fixed income</h2>
        <div class="card">
          <h2>Bonds &amp; CDs &mdash; search &amp; yields</h2>
          <table>
            <thead><tr><th>Symbol</th><th>Name</th><th class="num">Price</th><th class="num">Yield</th><th>Maturity</th><th>Frequency</th></tr></thead>
            <tbody>
              <% fixedIncome.bonds.forEach(function(b){ %>
              <tr><td><strong><%= b.symbol %></strong></td><td><%= b.name %></td><td class="num"><%= h.money(b.price) %></td><td class="num"><%= b.yld %>%</td><td><%= b.maturity %></td><td><%= b.freq %></td></tr>
              <% }); %>
              <% fixedIncome.cds.forEach(function(c){ %>
              <tr><td><strong>CD</strong></td><td>Certificate of Deposit &mdash; <%= c.term %></td><td class="num">$<%= h.num(c.min) %></td><td class="num"><%= c.apy %>% APY</td><td><%= c.term %></td><td>Monthly</td></tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div class="insights">
          <div class="card insights-half">
            <h2>Cash-flow analysis &amp; bond ladder</h2>
            <table>
              <thead><tr><th>Maturity</th><th class="num">Amount</th><th class="num">Yield</th></tr></thead>
              <tbody>
                <% fixedIncome.ladder.forEach(function(l){ %>
                <tr><td><%= l.year %></td><td class="num"><%= h.money(l.amount) %></td><td class="num"><%= l.yld %>%</td></tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <div class="card insights-half">
            <h2>Yield / maturity snapshot</h2>
            <ul class="breakdown">
              <% fixedIncome.bonds.map(function(b){ return {t:b.symbol, v:b.yld}; }).forEach(function(y){ %>
              <li><div class="bd-row"><span class="bd-type"><%= y.t %></span><span class="bd-val"><%= y.v %>%</span></div><div class="bd-bar"><span style="width:<%= Math.max(4, y.v*18).toFixed(1) %>%"></span></div></li>
              <% }); %>
            </ul>
          </div>
        </div>
      </section>