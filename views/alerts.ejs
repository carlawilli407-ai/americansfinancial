<%- include('partials/head', {title:'Alerts & Notifications - American Financial Associates'}) %>
<body class="dash">
  <%- include('partials/topbar') %>
  <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation">
    <span></span><span></span><span></span>
  </button>
  <div class="dash-overlay" id="dashOverlay"></div>
  <div class="dash-layout">
    <aside class="dash-nav">
      <div class="dash-nav-title">Menu</div>
      <nav>
        <a href="/dashboard"><span class="ic">&#127968;</span>Home</a>
        <a href="/portfolio"><span class="ic">&#128202;</span>Portfolio</a>
        <a href="/trading"><span class="ic">&#128200;</span>Trading</a>
        <a href="/watchlists"><span class="ic">&#128221;</span>Watchlists</a>
        <a href="/charting"><span class="ic">&#128201;</span>Advanced charting</a>
        <a href="/research"><span class="ic">&#128269;</span>Research</a>
        <a href="/planning"><span class="ic">&#127919;</span>Planning</a>
        <a href="/activity"><span class="ic">&#128338;</span>Activity</a>
        <a href="/alerts" class="active"><span class="ic">&#128276;</span>Alerts & notifications</a>
        <a href="/accounts"><span class="ic">&#128184;</span>Accounts</a>
        <a href="/fixed-income"><span class="ic">&#128176;</span>Fixed income</a>
        <a href="/profile"><span class="ic">&#128113;</span>My Profile</a>
      </nav>
    </aside>

    <main class="dash-main">
      <div class="market-ticker reveal">
        <div class="mt-label">Markets</div>
        <div class="mt-items">
          <% research.tabs.Stocks.concat(research.tabs.ETFs.slice(0,2)).forEach(function(q){ %>
          <div class="mt-item">
            <span class="mt-sym"><%= q.symbol %></span>
            <span class="mt-px"><%= h.money(q.price) %></span>
            <span class="mt-chg <%= q.changePct>=0?'pos':'neg' %>"><%= q.changePct>=0?'▲':'▼' %> <%= h.pct(q.changePct) %></span>
          </div>
          <% }); %>
        </div>
      </div>

      <section class="sec reveal">
        <h2 class="sec-h">Alerts & notifications</h2>
        <div class="sec-sub">Set up price, portfolio, and market alerts to stay informed.</div>
        
        <div class="alerts-grid">
          <div class="card">
            <h2>Create an alert</h2>
            <form class="alert-form" method="post" action="/alerts">
              <div class="tt-row"><label>Type</label>
                <select name="kind"><option>Price</option><option>Portfolio</option><option>Market</option></select>
              </div>
              <div class="tt-row"><label>Symbol</label><input name="symbol" placeholder="e.g. AAPL (optional)" class="form-input"></div>
              <div class="tt-row"><label>Trigger</label><input name="trigger" placeholder="e.g. Above 180.00" required class="form-input"></div>
              <button class="btn btn-primary btn-block" type="submit">Create alert</button>
            </form>
          </div>
          <div class="card">
            <h2>Your alerts</h2>
            <% if (alerts.length === 0) { %><div class="empty">No alerts set. Price, portfolio and market alerts will appear here.</div><% } else { %>
            <table>
              <thead><tr><th>Type</th><th>Symbol</th><th>Trigger</th><th>Status</th><th>Actions</th></tr></thead>
              <tbody>
                <% alerts.forEach(function(a){ %>
                <tr>
                  <td><%= a.kind %></td>
                  <td><%= a.symbol || '—' %></td>
                  <td><%= a.trigger %></td>
                  <td><span class="alert-status active"><span class="dot"></span>Active</span></td>
                  <td>
                    <form method="post" action="/alerts/<%= a.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this alert?');">
                      <button class="btn btn-secondary btn-sm" type="submit">Delete</button>
                    </form>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
            <% } %>
          </div>
        </div>
      </section>
    </main>
  </div>

  <%- include('partials/footer') %>
  <script>window.__DASH__ = <%- JSON.stringify(clientData) %>;</script>
  <script src="/static/js/dashboard.js?v=3"></script>
</body>
</html>