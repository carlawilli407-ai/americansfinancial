<%- include('partials/head', {title: 'Financial Planning - American Financial Associates'}) %>
<body>
  <%- include('partials/topbar') %>
  <div class="wrap">
    <div class="page-head">
      <span class="hp-badge"><span style="margin-right:6px;">&#10003;</span> Free calculators &amp; tools</span>
      <h1>Financial planning</h1>
      <p class="sub">Build a comprehensive plan for saving, spending, and reaching long-term goals with our free financial planning tools.</p>
    </div>

    <!-- Hero -->
    <section class="page-hero reveal">
      <div class="ph-in">
        <div class="ph-text">
          <h1>Plan your financial future</h1>
          <p class="sub">From setting a budget to planning for retirement, our interactive tools and educational guides help you take control of your financial life.</p>
          <div class="quick">
            <a class="btn btn-primary" href="/login">Try the planner</a>
            <a class="btn ghost" href="/login">Use a calculator</a>
          </div>
        </div>
        <div class="ph-img">
          <img class="ph-hero-img" src="/static/img/icon-planning.svg" alt="Illustration of financial planning tools">
        </div>
      </div>
    </section>

    <!-- Goal tracker -->
    <section class="reveal">
      <h2>Track your progress</h2>
      <p class="sub">Set goals and monitor how close you are to reaching them.</p>
      <div class="goal-grid">
        <div class="goal">
          <div class="goal-top">Emergency Fund</div>
          <div class="goal-bar"><span style="width:100%"></span></div>
          <div class="goal-vals">$18,000 / $18,000</div>
        </div>
        <div class="goal">
          <div class="goal-top">Retirement (401k)</div>
          <div class="goal-bar"><span style="width:75%"></span></div>
          <div class="goal-vals">$120,000 / $160,000</div>
        </div>
        <div class="goal">
          <div class="goal-top">Vacation Fund</div>
          <div class="goal-bar"><span style="width:45%"></span></div>
          <div class="goal-vals">$4,500 / $10,000</div>
        </div>
        <div class="goal">
          <div class="goal-top">Down Payment</div>
          <div class="goal-bar"><span style="width:30%"></span></div>
          <div class="goal-vals">$15,000 / $50,000</div>
        </div>
      </div>
    </section>

    <!-- Planning tools highlights -->
    <section class="reveal" style="padding-top:0">
      <h2>Planning tools &amp; resources</h2>
      <p class="sub" style="margin-bottom:30px">Interactive calculators, guides, and checklists to help you tackle every phase of financial planning.</p>
      <div class="hp-highlight-grid">
        <div class="hp-highlight">
          <svg class="hp-hl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20"/><circle cx="12" cy="12" r="9"/></svg>
          <h3>Budget calculator</h3>
          <p>Track your monthly income and expenses to understand your cash flow.</p>
        </div>
        <div class="hp-highlight">
          <svg class="hp-hl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="12" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
          <h3>Retirement planner</h3>
          <p>Estimate your retirement savings needs and project future balances.</p>
        </div>
        <div class="hp-highlight">
          <svg class="hp-hl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3v4"/><path d="M8 3v4"/><path d="M5 15h14v-6H5z"/></svg>
          <h3>College savings</h3>
          <p>Calculate how much you need to save for college expenses.</p>
        </div>
        <div class="hp-highlight">
          <svg class="hp-hl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10a2 2 0 0 1 2 2v5.83z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          <h3>Debt payoff</h3>
          <p>Create a strategy to pay down credit cards, student loans, and mortgages.</p>
        </div>
      </div>
    </section>

    <!-- Key metrics -->
    <section class="reveal">
      <h2>Financial health snapshot</h2>
      <p class="sub">Quick metrics to help you assess where you stand today.</p>
      <div class="kpi-grid">
        <div class="kpi">
          <div class="lbl">Recommended emergency fund</div>
          <div class="big">$18,000</div>
          <div class="sub pos">On track</div>
        </div>
        <div class="kpi">
          <div class="lbl">Retirement contribution</div>
          <div class="big">12%</div>
          <div class="sub pos">Goal: 15%</div>
        </div>
        <div class="kpi">
          <div class="lbl">Debt-to-income</div>
          <div class="big">0.28</div>
          <div class="sub pos">Healthy</div>
        </div>
        <div class="kpi">
          <div class="lbl">Credit score</div>
          <div class="big">782</div>
          <div class="sub pos">Excellent</div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="reveal" style="padding-top:0">
      <h2>Your planning process</h2>
      <p class="sub">A simple framework to guide your financial planning journey.</p>
      <div class="hp-how-grid">
        <div class="hp-step">
          <div class="hp-step-num">1</div>
          <div class="hp-step-title">Set goals</div>
          <div class="hp-step-desc">Identify short-term and long-term goals, from paying down debt to retirement.</div>
        </div>
        <div class="hp-step">
          <div class="hp-step-num">2</div>
          <div class="hp-step-title">Measure progress</div>
          <div class="hp-step-desc">Track your current savings, investments, and debt across all accounts.</div>
        </div>
        <div class="hp-step">
          <div class="hp-step-num">3</div>
          <div class="hp-step-title">Adjust &amp; optimize</div>
          <div class="hp-step-desc">Refine your plan based on life changes and market conditions.</div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="hp-cta-band reveal">
      <div class="hp-cta-in">
        <h2>Ready to take control?</h2>
        <p>Start planning your financial future with our free tools and expert guidance.</p>
        <div class="hp-cta-actions">
          <a class="btn" href="/login">Get started</a>
          <a class="btn ghost" href="/wealth">Talk to an advisor</a>
        </div>
      </div>
    </section>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
