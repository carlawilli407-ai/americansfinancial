<%- include('partials/head', {title: 'Investing & Trading - American Financial Associates'}) %>
<body>
  <%- include('partials/topbar') %>
  <div class="wrap">
    <div class="page-head">
      <span class="hp-badge"><span style="margin-right:6px;">&#10003;</span> $0 commission trades</span>
      <h1>Investing &amp; trading</h1>
      <p class="sub">Trade stocks, ETFs, mutual funds, options, and crypto with clear, low-cost pricing and powerful research tools.</p>
    </div>

    <!-- Hero -->
    <section class="page-hero reveal">
      <div class="ph-in">
        <div class="ph-text">
          <h1>Invest with confidence</h1>
          <p class="sub">American Financial Associates offers commission-free trades on a platform built for both beginners and active investors. Access real-time data, research, and screening tools in one integrated experience.</p>
          <div class="quick">
            <a class="btn btn-primary" href="/login">Start investing</a>
            <a class="btn ghost" href="/research">View research</a>
          </div>
        </div>
        <div class="ph-img">
          <img class="ph-hero-img" src="/static/img/icon-investing.svg" alt="Illustration of investing and trading features">
        </div>
      </div>
    </section>

    <!-- Key metrics -->
    <section class="reveal">
      <div class="summary">
        <div class="col">
          <div class="lbl">Commissions</div>
          <div class="big">$0</div>
          <div class="sub">per stock trade</div>
        </div>
        <div class="col">
          <div class="lbl">Account minimum</div>
          <div class="big">$0</div>
          <div class="sub">to open</div>
        </div>
        <div class="col">
          <div class="lbl">Research tools</div>
          <div class="big">200+</div>
          <div class="sub">analyst ratings</div>
        </div>
      </div>
    </section>

    <!-- Highlight features -->
    <section class="reveal" style="padding-top:0">
      <h2>What we offer</h2>
      <p class="sub">From your first trade to building a long-term portfolio, we have the tools and guidance you need.</p>
      <div class="hp-highlight-grid">
        <div class="hp-highlight">
          <svg class="hp-hl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          <h3>Research &amp; screen</h3>
          <p>Access analyst reports, screen stocks, and compare funds with our intuitive research tools.</p>
        </div>
        <div class="hp-highlight">
          <svg class="hp-hl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="12" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/><circle cx="12" cy="15" r="2"/></svg>
          <h3>Low-cost trading</h3>
          <p>Trade stocks, ETFs, and options with $0 commissions and no account minimums.</p>
        </div>
        <div class="hp-highlight">
          <svg class="hp-hl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10a2 2 0 0 1 2 2v5.83z"/><line x1="7" y1="7" x2="7.01" y2="7"/><line x1="15" y1="12" x2="15.01" y2="12"/></svg>
          <h3>Portfolio tools</h3>
          <p>Build and track your portfolio with rebalancing alerts and performance tracking.</p>
        </div>
        <div class="hp-highlight">
          <svg class="hp-hl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3v4"/><path d="M8 3v4"/><path d="M5 15h14v-6H5z"/></svg>
          <h3>Educational content</h3>
          <p>Learn investing basics with guided courses and step-by-step tutorials.</p>
        </div>
      </div>
    </section>

    <!-- Asset allocation -->
    <section class="reveal">
      <h2>Investment products</h2>
      <p class="sub">Diversify across asset classes with our full range of investment products.</p>
      <div class="kpi-grid">
        <div class="kpi">
          <div class="lbl">Stocks</div>
          <div class="big">15,000+</div>
          <div class="sub">Commission-free</div>
        </div>
        <div class="kpi">
          <div class="lbl">ETFs &amp; Mutual Funds</div>
          <div class="big">3,500+</div>
          <div class="sub">No-minimum funds</div>
        </div>
        <div class="kpi">
          <div class="lbl">Options</div>
          <div class="big">0.50</div>
          <div class="sub">$ per contract</div>
        </div>
        <div class="kpi">
          <div class="lbl">Crypto</div>
          <div class="big">160+</div>
          <div class="sub">Coins &amp; tokens</div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="reveal" style="padding-top:0">
      <h2>How to get started</h2>
      <p class="sub">Three simple steps to your first trade.</p>
      <div class="hp-how-grid">
        <div class="hp-step">
          <div class="hp-step-num">1</div>
          <div class="hp-step-title">Open your account</div>
          <div class="hp-step-desc">Fill out our quick application to set up your brokerage account.</div>
        </div>
        <div class="hp-step">
          <div class="hp-step-num">2</div>
          <div class="hp-step-title">Fund your account</div>
          <div class="hp-step-desc">Link your bank account and transfer funds.</div>
        </div>
        <div class="hp-step">
          <div class="hp-step-num">3</div>
          <div class="hp-step-title">Start investing</div>
          <div class="hp-step-desc">Buy your first shares and build your portfolio.</div>
        </div>
      </div>
    </section>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
