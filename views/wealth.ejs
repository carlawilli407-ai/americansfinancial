<%- include('partials/head', {title: 'Wealth Management - American Financial Associates'}) %>
<body>
  <%- include('partials/topbar') %>
  <div class="wrap">
    <div class="page-head">
      <span class="hp-badge"><span style="margin-right:6px;">&#10003;</span> Dedicated advisors</span>
      <h1>Wealth management</h1>
      <p class="sub">Personalized financial planning and investment management from dedicated professionals.</p>
    </div>

    <!-- Hero -->
    <section class="page-hero reveal">
      <div class="ph-in">
        <div class="ph-text">
          <h1>Your goals, our expertise</h1>
          <p class="sub">Work with a dedicated advisor who understands your unique situation and creates a comprehensive plan to help you build, manage, and preserve wealth.</p>
          <div class="quick">
            <a class="btn btn-primary" href="/login">Schedule a consultation</a>
            <a class="btn ghost" href="/wealth">Find an advisor</a>
          </div>
        </div>
        <div class="ph-img">
          <img class="ph-hero-img" src="/static/img/icon-wealth.svg" alt="Illustration of wealth management services">
        </div>
      </div>
    </section>

    <!-- Key metrics -->
    <section class="reveal">
      <div class="summary">
        <div class="col">
          <div class="lbl">Avg advisor experience</div>
          <div class="big">20+</div>
          <div class="sub">years</div>
        </div>
        <div class="col">
          <div class="lbl">Assets under management</div>
          <div class="big">$8.2B</div>
          <div class="sub">total AUM</div>
        </div>
        <div class="col">
          <div class="lbl">Client satisfaction</div>
          <div class="big">96%</div>
          <div class="sub pos">satisfaction rate</div>
        </div>
      </div>
    </section>

    <!-- Services highlights -->
    <section class="reveal" style="padding-top:0">
      <h2>Our wealth management services</h2>
      <p class="sub" style="margin-bottom:30px">From comprehensive financial planning to sophisticated investment strategies, we provide the expertise to help you achieve your goals.</p>
      <div class="hp-highlight-grid">
        <div class="hp-highlight">
          <svg class="hp-hl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10a2 2 0 0 1 2 2v5.83z"/><line x1="7" y1="7" x2="7.01" y2="7"/><line x1="15" y1="12" x2="15.01" y2="12"/></svg>
          <h3>Financial planning</h3>
          <p>Comprehensive plans covering cash flow, retirement, taxes, insurance, and estate considerations.</p>
        </div>
        <div class="hp-highlight">
          <svg class="hp-hl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="12" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/><circle cx="12" cy="15" r="3"/></svg>
          <h3>Investment management</h3>
          <p>Tax-efficient, diversified portfolios tailored to your risk tolerance and time horizon.</p>
        </div>
        <div class="hp-highlight">
          <svg class="hp-hl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3v4"/><path d="M8 3v4"/><path d="M5 15h14v-6H5z"/></svg>
          <h3>Tax optimization</h3>
          <p>Strategies to minimize taxes now and in retirement, including tax-loss harvesting and asset location.</p>
        </div>
        <div class="hp-highlight">
          <svg class="hp-hl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12V6a2 2 0 0 1 2-2h8l4 4v8"/><path d="M16 2h6v6l-4 4-6 6-6-6 4-4z"/><line x1="12" y1="2" x2="12" y2="8"/></svg>
          <h3>Estate planning</h3>
          <p>Coordinate with estate attorneys to structure your assets for efficient transfer to beneficiaries.</p>
        </div>
      </div>
    </section>

    <!-- Advisors team -->
    <section class="reveal">
      <h2>Meet our advisors</h2>
      <p class="sub">Each client is paired with a dedicated advisor who serves as a single point of contact.</p>
      <div class="insights">
        <div class="card insights-half">
          <div style="display:flex;align-items:center;gap:16px;margin-bottom:12px">
            <div class="avatar" style="width:64px;height:64px;font-size:20px">M</div>
            <div>
              <h3 style="margin:0 0 2px">Michael Rodriguez, CFP&reg;</h3>
              <p class="muted" style="margin:0;font-size:13px">Senior Wealth Advisor</p>
            </div>
          </div>
          <p style="font-size:14px;color:var(--muted-2);line-height:1.5">Specializes in retirement planning and concentrated stock management. 15+ years experience.</p>
          <div class="quick" style="margin-top:16px">
            <a class="btn btn-primary btn-sm" href="/login">Schedule intro call</a>
          </div>
        </div>
        <div class="card insights-half">
          <div style="display:flex;align-items:center;gap:16px;margin-bottom:12px">
            <div class="avatar" style="width:64px;height:64px;font-size:20px">S</div>
            <div>
              <h3 style="margin:0 0 2px">Sarah Chen, CFA&reg;</h3>
              <p class="muted" style="margin:0;font-size:13px">Portfolio Management Director</p>
            </div>
          </div>
          <p style="font-size:14px;color:var(--muted-2);line-height:1.5">Oversees portfolio construction and risk management across all client segments. 12+ years experience.</p>
          <div class="quick" style="margin-top:16px">
            <a class="btn btn-primary btn-sm" href="/login">Schedule intro call</a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="hp-cta-band reveal">
      <div class="hp-cta-in">
        <h2>Take the next step</h2>
        <p>Ready to work with an advisor who will help you achieve your financial goals?</p>
        <div class="hp-cta-actions">
          <a class="btn" href="/login">Schedule a consultation</a>
          <a class="btn ghost" href="/planning">Explore financial planning</a>
        </div>
      </div>
    </section>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
