# Database Configuration
# ====================
# For PostgreSQL/Supabase: Set DATABASE_URL
# The connection string should use your actual Supabase database password

# Example PostgreSQL connection string (IPv4-friendly):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.bsgpwrevsmqvvsignrda.supabase.co:5432/postgres

# Alternative: Use the connection string directly from Supabase dashboard
# Settings -> Database -> Connection Pooler -> Connection string

# For Supabase client (optional - if using @supabase/supabase-js):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key

# Admin password for seeded admin user (works in both SQLite and PostgreSQL/Vercel modes)
ADMIN_PASS=admin123

# Session secret (REQUIRED for Vercel — set a stable value to preserve sessions
# across cold starts. If not set, a secret is auto-derived from DATABASE_URL on Vercel.)
SESSION_SECRET=