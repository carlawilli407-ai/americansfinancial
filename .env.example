# Database Configuration
# ====================
# For PostgreSQL/Supabase: Set DATABASE_URL
# Get this from Supabase Dashboard → Project Settings → Database → Connection string
# Prefer the "Transaction pooler" URI (port 6543) for serverless/Vercel.

# Supabase pooler (recommended for Vercel/serverless):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (migrations, local dev):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Project: americansfinancial (ksnqvngdnbhkwzdeyzdw)
# URL: https://ksnqvngdnbhkwzdeyzdw.supabase.co

# Admin password for seeded admin user (works in both SQLite and PostgreSQL/Vercel modes)
ADMIN_PASS=admin123

# Session secret (REQUIRED for Vercel — set a stable value to preserve sessions
# across cold starts. If not set, a secret is auto-derived from DATABASE_URL on Vercel.)
SESSION_SECRET=

# Verify Supabase connection:
#   npm run test:supabase
# Run migrations (creates tables + enables RLS):
#   npm run migrate
